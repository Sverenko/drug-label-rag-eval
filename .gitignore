# Secrets. Keys live in .env, which is never committed; copy .env.example to start.
.env
.env.*
!.env.example

# Data. Everything under data/ is regenerated by the scripts and stays local,
# except the manifest that pins which labels were used and a small test sample.
data/*
!data/manifest.csv
!data/sample/

# Cached API responses (embeddings, reranks, answers)
.cache/

# Safety net: vector files and archives anywhere in the tree
*.npy
*.npz
*.zip

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
